# ---- Application ----
APP_ENV=development                 # development | test | production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---- Database / queue ----
DATABASE_URL=postgresql+psycopg://ats:CHANGE_ME@localhost:5432/ats
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=false                  # true runs background tasks in-process (no worker)

# ---- Authentication ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false                 # must be true in production (HTTPS)
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- Uploads & storage ----
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=10
RETENTION_DAYS=365

# ---- CORS & rate limits ----
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=30
RATE_LIMIT_AI_PER_HOUR=60

# ---- AI provider (optional; without a key a clearly labelled built-in writer is used) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=90
SEMANTIC_BACKEND=auto               # auto | sentence-transformers | tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- OCR / PDF conversion ----
OCR_ENABLED=true
TESSDATA_DIR=
SOFFICE_PATH=                       # e.g. /Applications/LibreOffice.app/Contents/MacOS/soffice
CONVERSION_TIMEOUT_SECONDS=60

# ---- Optional integrations ----
SMTP_URL=                           # smtp://user:pass@host:587 enables password-reset email and reminders
EMAIL_FROM=
JOB_PROVIDER=manual
